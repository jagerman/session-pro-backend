# Configuration for scripts/pgbackrest/repo-host-setup.sh (run ON the backup/repository host).
#
# Copy to repo-host.env, fill in the values (most are printed by the primary's deploy.sh run),
# then: sudo ./scripts/pgbackrest/repo-host-setup.sh
#
# Verified end-to-end against a live primary + repo host (pgbackrest 2.58).

# The primary (database) host: SSH target + PostgreSQL details, from the primary's deploy output.
PRIMARY_HOST="pro.example.org"          # ssh-reachable host/IP of the primary
PRIMARY_SSH_USER="postgres"             # SSH + PG OS user on the primary (peer-auth postgres)
PRIMARY_PG_DATA_DIR="/var/lib/postgresql/17/session_pro"   # primary's cluster data dir
PRIMARY_PG_PORT="5433"                  # primary's dedicated-cluster port

# Repository storage on THIS host.
REPO_USER="pgbackrest"
REPO_PATH="/var/lib/pgbackrest"

# Must be byte-identical to the primary's cipher pass
# (primary: /etc/session-pro-backend/pgbackrest-cipher.pass).
CIPHER_PASS=""
