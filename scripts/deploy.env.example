# Deployment configuration for scripts/deploy.sh.
#
# Copy to deploy.env, edit, then run (as root):  ./scripts/deploy.sh
# (deploy.sh sources ./deploy.env from the repo root if present.)
#
# This file holds deployment inputs only — no PostgreSQL password (the app uses peer auth
# over the unix socket). Keep it out of world-readable locations if you set a cipher pass.

# ---- Source ----------------------------------------------------------------------------
# Upstream repo + ref to deploy. Defaults are the canonical upstream, NOT a personal fork.
GIT_REPO="https://github.com/session-foundation/session-pro-backend"
GIT_REF="main"

# ---- Web fronting ----------------------------------------------------------------------
# server_name for the generated nginx vhost. TLS is NOT configured by this script — after
# deploy, set up certificates yourself (e.g. certbot); deploy.sh prints instructions.
PRO_DOMAIN="pro.example.org"

# ---- Provider toggles ------------------------------------------------------------------
# Bring the instance up with platforms disabled first if you don't have credentials yet;
# fill [apple]/[google] in /etc/session-pro-backend/config.ini later and flip these on.
WITH_PROVIDER_APP_STORE="false"
WITH_PROVIDER_GOOGLE_PLAY="false"

# ---- Off-host durability (pgBackRest) --------------------------------------------------
# The pgBackRest repository lives on a REMOTE host (plain file storage; it does not need to
# run PostgreSQL). deploy.sh configures the dedicated cluster to archive WAL there and runs
# `stanza-create`. SSH from this host to the repo host must be set up for the postgres user
# (key-based, non-interactive) BEFORE running deploy.sh.
#
# Leave PGBACKREST_REPO_HOST empty to skip backup setup entirely (e.g. a throwaway box).
PGBACKREST_REPO_HOST=""              # e.g. backup.example.org  (SSH host)
PGBACKREST_REPO_HOST_USER="pgbackrest"
PGBACKREST_REPO_PATH="/var/lib/pgbackrest"

# Repository encryption passphrase. STRONGLY recommended: in Phase-1 the signing key still
# lives in the database, so it rides along in backups shipped off-host. If left empty,
# deploy.sh generates one and records it at /etc/session-pro-backend/pgbackrest-cipher.pass
# (0600) — back that up somewhere safe or you cannot restore.
PGBACKREST_CIPHER_PASS=""

# WAL archive timeout (seconds) → worst-case RPO when the DB is idle (a busy DB archives as
# soon as segments fill, often faster). 30 ≈ 30s; lower = tighter RPO, more (tiny, compressed)
# idle segment switches.
PG_ARCHIVE_TIMEOUT="30"
